          "name": "1. Register User (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created (or 409 if already registered)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.tokens) {",
                  "        pm.collectionVariables.set('accessToken', res.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', res.data.tokens.refreshToken);",
                  "        console.log('Tokens saved automatically to collection variables!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@savewise.io\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Joel\",\n  \"lastName\": \"Kiggwe\",\n  \"dateOfBirth\": \"1994-06-15\",\n  \"phoneNumber\": \"+2348012345678\"\n}"
