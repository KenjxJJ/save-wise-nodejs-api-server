                  "});",
                  "pm.test(\"Validation error catches invalid avatar URL\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.eql(\"Validation failed\");",
                  "    var urlErr = json.errors.find(e => e.field === 'avatarUrl');",
                  "    pm.expect(urlErr).to.not.be.undefined;",
                  "    pm.expect(urlErr.message).to.include(\"Invalid avatar URL\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
